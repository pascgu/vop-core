{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VopFlowSchema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Version of the VopFlow schema"
    },
    "name": {
      "type": "string",
      "description": "Name of the VopFlow"
    },
    "metadata": {
      "type": "object",
      "description": "VopFlow metadata",
      "properties": {
        "author": {
          "type": "string",
          "description": "Author of the VopFlow"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp of the VopFlow"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp of the VopFlow"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the node"
          },
          "type": {
            "type": "string",
            "description": "Type of the node",
            "enum": ["import", "start", "function_call", "method_call", "loop", "conditional", "variable", "comment"]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "X-coordinate of the node"
              },
              "y": {
                "type": "number",
                "description": "Y-coordinate of the node"
              }
            },
            "required": ["x", "y"]
          },
          "data": {
            "type": "object",
            "description": "Node-specific data",
            "properties": {
              "module": {
                "type": "string",
                "description": "Module name for import nodes"
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Symbols to import"
              },
              "alias": {
                "type": "string",
                "description": "Import alias"
              },
              "prototype": {
                "type": "string",
                "description": "Full prototype path for function calls"
              },
              "target": {
                "type": "string",
                "description": "Target object for method calls"
              },
              "method": {
                "type": "string",
                "description": "Method name for method calls"
              },
              "loop_type": {
                "type": "string",
                "enum": ["for", "while"],
                "description": "Type of loop"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Input identifier"
                    },
                    "type": {
                      "type": "string",
                      "description": "Input type (can be multiple types separated by |)"
                    },
                    "value": {
                      "description": "Input value"
                    }
                  },
                  "required": ["id", "type"]
                },
                "description": "Node inputs"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Output identifier"
                    },
                    "type": {
                      "type": "string",
                      "description": "Output type"
                    }
                  },
                  "required": ["id", "type"]
                },
                "description": "Node outputs"
              },
              "properties": {
                "type": "object",
                "description": "Display properties",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Display label for the node"
                  }
                }
              }
            }
          }
        },
        "required": ["id", "type", "position", "data"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the edge"
          },
          "source": {
            "type": "string",
            "description": "Source node ID or node.output ID"
          },
          "target": {
            "type": "string",
            "description": "Target node ID or node.input ID"
          },
          "type": {
            "type": "string",
            "enum": ["flow", "data"],
            "description": "Edge type"
          },
          "animated": {
            "type": "boolean",
            "description": "Whether the edge is animated"
          },
          "data": {
            "type": "object",
            "description": "Edge-specific data",
            "properties": {
              "label": {
                "type": "string",
                "description": "Edge label"
              }
            }
          }
        },
        "required": ["id", "source", "target", "type"]
      }
    }
  },
  "required": ["version", "name", "nodes", "edges", "metadata"]
}
